# ============================================================
# Tradertoolsth Signal Server - environment template
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่อง
#   cp .env.example .env      (Git Bash / Linux / macOS)
#   copy .env.example .env    (Windows cmd)
# ============================================================

# พอร์ตที่ Express รอรับ HTTP จาก EA
PORT=8787

# API key ที่ EA ต้องส่งมาใน header "x-api-key" เพื่อเขียนข้อมูล (POST)
# GET (อ่าน) ไม่ต้องใช้ key  เปลี่ยนเป็นค่าที่ยากเดาและเก็บเป็นความลับ
API_KEY=change-me-to-a-long-random-string

# ที่อยู่ไฟล์ SQLite ถ้าเว้นว่างจะใช้ ./data/tradertoolsth.sqlite
DB_PATH=

# Origin ที่อนุญาตสำหรับ CORS (หน้าเว็บที่ดึง API)
# ค่าเริ่มต้น * สำหรับทดสอบในเครื่อง  สำหรับ deploy จริงควรระบุโดเมนเช่น https://tradertoolsth.example
ALLOWED_ORIGIN=*

# ระยะเวลา (วินาที) ที่หากข้อมูล market/signal เก่ากว่านี้ จะถือว่าสถานะ STALE
STALE_SECONDS=15

# จำนวนแท่งเทียน (M1 และ M5) ที่ backend เก็บต่อ symbol (ล่าสุด N แท่ง)
MAX_CANDLES=120
